<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#101322" android:fillViewport="true"><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp"><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="POWER LEVEL" android:textColor="#FFB52E" android:textSize="14sp" android:textStyle="bold"/><TextView android:id="@+id/levelTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="SAIYAN TRAINING" android:textColor="#FFFFFF" android:textSize="30sp" android:textStyle="bold" android:paddingBottom="8dp"/><TextView android:id="@+id/xpText" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="LEVEL 1 • 0 XP" android:textColor="#FFB52E" android:textSize="18sp" android:padding="10dp"/><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="TODAY'S MISSIONS" android:textColor="#FFFFFF" android:textSize="20sp" android:textStyle="bold" android:paddingTop="14dp"/><CheckBox android:id="@+id/stepsCheck" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Reach 10,000 steps (+50 XP)" android:textColor="#FFFFFF" android:buttonTint="#FFB52E"/><CheckBox android:id="@+id/proteinCheck" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Hit protein target (+50 XP)" android:textColor="#FFFFFF" android:buttonTint="#FFB52E"/><Button android:id="@+id/workoutButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="COMPLETE TODAY'S WORKOUT  +100 XP" android:backgroundTint="#F57C00" android:textColor="#FFFFFF"/><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="TRAINING SPLIT" android:textColor="#FFFFFF" android:textSize="20sp" android:textStyle="bold" android:paddingTop="20dp"/><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="MON • Upper body\nTUE • Lower body\nWED • Rest / mobility\nTHU • Push (chest, shoulders, triceps)\nFRI • Pull (back, biceps)\nSAT • Legs + core\nSUN • Rest and recover" android:textColor="#D6D8E4" android:textSize="16sp" android:lineSpacingExtra="5dp"/><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="BODY CHECK-IN" android:textColor="#FFFFFF" android:textSize="20sp" android:textStyle="bold" android:paddingTop="20dp"/><EditText android:id="@+id/weightInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Weight today (lb)" android:inputType="numberDecimal" android:textColor="#FFFFFF" android:textColorHint="#A5A8BB" android:backgroundTint="#FFB52E"/><Button android:id="@+id/saveWeightButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="SAVE WEIGHT CHECK-IN" android:backgroundTint="#39415F" android:textColor="#FFFFFF"/><TextView android:id="@+id/statusText" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Your journey starts today. Train consistently and recover well." android:textColor="#BFC4D8" android:textSize="14sp" android:paddingTop="12dp" android:paddingBottom="30dp"/></LinearLayout></ScrollView>